{
  "name": "qimen-gesture-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "A real-time gesture-controlled Qimen formation experiment built with MediaPipe, Three.js and WebGL.",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/sync-mediapipe-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/test-loader.mjs --test tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
